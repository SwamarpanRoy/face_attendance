# Installed by scripts/setup_pi.sh as /etc/sudoers.d/attendance (mode 440).
# The device user may reboot or power off without a password, nothing else.
__USER__ ALL=(root) NOPASSWD: /sbin/reboot, /sbin/shutdown, /usr/sbin/reboot, /usr/sbin/shutdown, /usr/bin/systemctl reboot, /usr/bin/systemctl poweroff
