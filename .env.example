# Server configuration. Copy to .env (never committed) and edit.
# Loaded by server/app/config.py (pydantic-settings) and by the tools/ scripts.

# PostgreSQL 16. The docker-compose file in server/deploy/ creates this user/db.
DATABASE_URL=postgresql+psycopg://attendance:change-me@127.0.0.1:5432/attendance
# Separate database for the integration tests (created/dropped by the test fixtures).
TEST_DATABASE_URL=postgresql+psycopg://attendance:change-me@127.0.0.1:5432/attendance_test

# Used by server/deploy/docker-compose.yml to initialise Postgres. Keep in sync with DATABASE_URL.
POSTGRES_USER=attendance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=attendance

# Signs admin session cookies and CSRF tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Set to true once the server is behind HTTPS (Tailscale Serve / reverse proxy).
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=12

# Where 112x112 enrolment crops are kept (server only, never on the device).
CROPS_DIR=data/crops
# Held-out probe crops for calibration (server only; covered by the same consent).
PROBES_DIR=data/probes
# Calibration reports and plots: tools/calibrate.py writes <CALIBRATION_DIR>/<timestamp>/.
CALIBRATION_DIR=calibration
# Where tools/fetch_models.py puts det_500m.onnx and w600k_mbf.onnx.
MODELS_DIR=models
# Tag stored with every template so a model change triggers tools/reembed.py.
MODEL_VERSION=buffalo_s/w600k_mbf

# Admin UI policy
ATTENDANCE_SHORTAGE_THRESHOLD_PCT=75
FACULTY_EDIT_WINDOW_DAYS=7
# Bump when the consent notice wording changes; stored with every consent.
CONSENT_VERSION=2026-10-v1
# CONSENT_NOTICE=...   (defaults to the DPDP wording in server/app/config.py)

# Server-side recognition for enrolment photos (ID-card scans are soft and small).
SERVER_DETECTOR_INPUT=640
ENROL_MIN_FACE_PX=60
ENROL_MIN_BLUR=30
ENROL_MAX_YAW_DEG=30

# Display timezone for the admin UI and reports (data is stored in UTC)
TIMEZONE=Asia/Kolkata

# Login throttling and request size cap
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
MAX_REQUEST_BYTES=5242880

# Logging
LOG_LEVEL=INFO

# tools/seed_demo.py reads these; anything left blank is generated and printed once.
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=
SEED_FACULTY_EMAIL=faculty@demo.local
SEED_FACULTY_PASSWORD=
SEED_ADMIN_PIN=
SEED_PIN=
